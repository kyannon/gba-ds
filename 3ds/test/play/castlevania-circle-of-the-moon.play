# power on -> file -> name -> intro -> in the castle (field). Bottom screen = pause-screen map captured on the hidden copy (CVC-1)
wait 180
mash START 4 40
mash A 4 40
wait 120
mash A 40 40
wait 120
shot naming
mash START 4 40
mash A 80 40
wait 120
shot intro
mash A 60 40
wait 120
shot field
wait 120
shot field2
hold RIGHT 200
wait 120
shot walk
hold RIGHT 200
wait 120
shot walk2
hold LEFT 300
wait 120
shot room
# the game's own map on the game screen (SELECT), then back
press SELECT 8
wait 120
shot map-open
press SELECT 8
wait 120
shot map-closed
# pause screen (START, shown 90 frames in) and back
press START 8
wait 90
shot pause
press B 8
wait 90
shot after-pause
press HOME+R 6
hold RIGHT 90
shot moved
press HOME+L 6
wait 20
shot loaded
press HOME 6
wait 30
shot menu2
press HOME 6
wait 30
press HOME+UP 6
wait 20
shot swapped
press HOME+UP 6
wait 20
shot back
