{
  "name": "GBA DS",
  "uniqueId": "gba.io.github.kyannon.gbads",
  "description": "Dual-screen GBA for two-screen handhelds: the game's map, HUD or logo on the second screen. Supported extensions: gba, zip, 7z.",
  "acceptedFilenameRegex": "^(.*)\\.(?:gba|zip|7z)$",
  "amStartArguments": "-n io.github.kyannon.gbads/.LauncherActivity\n  -a android.intent.action.VIEW\n  -d {file.uri}\n  --activity-clear-task\n  --activity-clear-top",
  "killPackageProcesses": false,
  "killPackageProcessesWarning": true,
  "extra": ""
}
